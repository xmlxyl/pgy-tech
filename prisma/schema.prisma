// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner          Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SavedEmail {
  id        Int      @id @default(autoincrement())
  shop      String
  email     String
  username  String?
  createdAt DateTime @default(now())

  @@index([shop])
}

model PriceChangeTask {
  id                 Int                   @id @default(autoincrement())
  shop               String
  name               String
  status             String                @default("Pending")
  fileName           String
  totalCount         Int                   @default(0)
  successCount       Int                   @default(0)
  failedCount        Int                   @default(0)
  createdBy          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              PriceChangeTaskItem[]

  @@index([shop, status])
}

model PriceChangeTaskItem {
  id            Int             @id @default(autoincrement())
  taskId        Int
  task          PriceChangeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sku           String
  productId     String
  variantId     String
  originalPrice           Decimal  @db.Decimal(12, 2)
  originalCompareAtPrice  Decimal? @db.Decimal(12, 2)
  targetPrice             Decimal  @db.Decimal(12, 2)
  changeStatus  String          @default("Pending")
  restoreStatus String          @default("Pending")
  errorMessage  String?
  changedAt     DateTime?
  restoredAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([taskId, sku])
  @@index([taskId])
  @@index([sku])
}

model MysteryBoxSetting {
  id             Int      @id @default(autoincrement())
  shop           String   @unique
  startDate      DateTime @default(now())
  minOrderAmount Decimal  @default(149) @db.Decimal(12, 2)
  webhookUrl     String?
  usRules        Json
  intlRules      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MysteryBoxDraw {
  id         Int      @id @default(autoincrement())
  shop       String
  orderId    String
  orderName  String?
  customerId String?
  region     String
  prizeType  String
  prizeSku   String?
  prizeTitle String?
  orderTotal Decimal  @db.Decimal(12, 2)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, customerId])
}

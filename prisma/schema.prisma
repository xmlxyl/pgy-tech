// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel+Neon：运行时用 pooled；迁移用 unpooled（Neon 自动注入的变量名）
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner          Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SavedEmail {
  id        Int      @id @default(autoincrement())
  shop      String
  email     String
  createdAt DateTime @default(now())

  @@index([shop])
}

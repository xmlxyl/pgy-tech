{%- liquid
  assign disc_mode = mode | default: 'banner'
  assign disc_hub = hub | default: ''
  assign l1 = label_1 | default: 'Extra 2% OFF'
  assign l2 = label_2 | default: 'Extra 3% OFF'
  assign l3 = label_3 | default: 'Extra 5% OFF'
  assign slice_labels = l1 | append: '||' | append: l2 | append: '||' | append: l3 | append: '||' | append: l1 | append: '||' | append: l2 | append: '||' | append: l3 | split: '||'
-%}
<div class="pgy-lw__disc{% if disc_mode == 'modal' %} pgy-lw__disc--modal{% endif %}" aria-hidden="true">
  <span class="pgy-lw__pointer"></span>
  <div class="pgy-lw__wheel">
    <div class="pgy-lw__rotor"{% if disc_mode == 'modal' %} data-pgy-lw-rotor{% endif %}>
      {% for slice_label in slice_labels %}
        <span class="pgy-lw__label" style="--i: {{ forloop.index0 }}">
          <span class="pgy-lw__label-inner">
            <svg class="pgy-lw__gift" viewBox="0 0 24 24" focusable="false">
              <rect x="3" y="11" width="18" height="10" rx="1.6" fill="#e39a2d"></rect>
              <rect x="2" y="8" width="20" height="4.2" rx="1.2" fill="#f3c65a"></rect>
              <rect x="10.4" y="8" width="3.2" height="13" fill="#fff7ea"></rect>
              <path d="M12 8.2c-1.8 0-3.2-1.6-2.3-3 .7-1.1 2.3.2 2.3 3 0-2.8 1.6-4.1 2.3-3 .9 1.4-.5 3-2.3 3z" fill="#ef6d6d"></path>
            </svg>
            {%- liquid
              assign label_head = slice_label
              assign label_tail = ''
              if slice_label contains ' OFF'
                assign label_head = slice_label | split: ' OFF' | first
                assign label_tail = 'OFF'
              endif
            -%}
            <span class="pgy-lw__label-text" data-pgy-lw-slice="{{ forloop.index0 | modulo: 3 }}" data-pgy-lw-label="{{ slice_label | escape }}">
              {{- label_head -}}
              {%- if label_tail != blank -%}<br>{{ label_tail }}{%- endif -%}
            </span>
          </span>
        </span>
      {% endfor %}
    </div>
    <span class="pgy-lw__hub{% if disc_hub != blank %} pgy-lw__hub--play{% endif %}">
      {%- if disc_hub != blank -%}{{ disc_hub }}{%- endif -%}
    </span>
  </div>
</div>

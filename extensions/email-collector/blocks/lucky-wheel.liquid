{% liquid
  assign heading = 'lucky_wheel.heading' | t
  if block.settings.heading != blank and block.settings.heading != 'Lucky Wheel — 100% Win Rate!'
    assign heading = block.settings.heading
  endif
  assign how_heading = 'lucky_wheel.how_heading' | t
  if block.settings.how_heading != blank and block.settings.how_heading != 'How It Works:'
    assign how_heading = block.settings.how_heading
  endif
  assign step_1 = 'lucky_wheel.step_1' | t
  if block.settings.step_1 != blank and block.settings.step_1 != 'Click the “Play” button on the wheel.'
    assign step_1 = block.settings.step_1
  endif
  assign step_2 = 'lucky_wheel.step_2' | t
  if block.settings.step_2 != blank and block.settings.step_2 != 'Enter your email to unlock your spin.'
    assign step_2 = block.settings.step_2
  endif
  assign step_3 = 'lucky_wheel.step_3' | t
  if block.settings.step_3 != blank and block.settings.step_3 != 'Spin the wheel to reveal your prizes.'
    assign step_3 = block.settings.step_3
  endif
  assign step_4 = 'lucky_wheel.step_4' | t
  if block.settings.step_4 != blank and block.settings.step_4 != 'Discounts start November 18 and can be combined with Black Friday deals!'
    assign step_4 = block.settings.step_4
  endif
  assign modal_title = 'lucky_wheel.modal_title' | t
  if block.settings.modal_title != blank and block.settings.modal_title != 'One Spin Per Person · Everyone Wins' and block.settings.modal_title != 'Lucky Wheel — 100% Win Rate!'
    assign modal_title = block.settings.modal_title
  endif
  assign modal_sub = 'lucky_wheel.modal_sub' | t
  if block.settings.modal_sub != blank and block.settings.modal_sub != 'Sign up and spin to get your early-access link by email on November 18, and shop Black Friday deals 24 hours early.' and block.settings.modal_sub != 'Enter your email to unlock your spin.'
    assign modal_sub = block.settings.modal_sub
  endif
  assign spin_label = 'lucky_wheel.spin' | t
  if block.settings.spin_label != blank and block.settings.spin_label != 'SPIN TO WIN'
    assign spin_label = block.settings.spin_label
  endif
  assign footnote = 'lucky_wheel.step_4' | t
  if block.settings.footnote != blank and block.settings.footnote != 'Discounts start November 18 and can be combined with Black Friday deals!'
    assign footnote = block.settings.footnote
  endif
  assign play_label = 'lucky_wheel.play' | t
  if block.settings.play_label != blank and block.settings.play_label != 'Play'
    assign play_label = block.settings.play_label
  endif
  assign customer_email = ''
  if customer and customer.email != blank
    assign customer_email = customer.email
  endif
  assign proxy_url = '/apps/pgy-tech/lucky-wheel'
  assign hero_image = 'lucky-wheel-hero.png' | asset_url
  if block.settings.image != blank
    assign hero_image = block.settings.image | image_url: width: 1400
  endif
  assign disc_image = 'lucky-wheel-disc.png' | asset_url
  assign play_image = 'lucky-wheel-play.png' | asset_url
  assign pointer_image = 'lucky-wheel-pointer.png' | asset_url
  assign banner_image = 'lucky-wheel-banner-bg.png' | asset_url
%}

<div
  class="pgy-lw"
  id="pgy-lw"
  data-pgy-lw
  data-mode="block"
  data-proxy-url="{{ proxy_url }}"
  data-customer-email="{{ customer_email | escape }}"
  data-footnote="{{ footnote | escape }}"
  data-spin-label="{{ spin_label | escape }}"
  data-spinning-label="{{ 'lucky_wheel.spinning' | t | escape }}"
  data-reward-template="{{ 'lucky_wheel.played_reward' | t | escape }}"
  data-msg-invalid="{{ 'lucky_wheel.invalid' | t | escape }}"
  data-msg-error="{{ 'lucky_wheel.error' | t | escape }}"
  data-msg-preview="{{ 'lucky_wheel.preview' | t | escape }}"
  data-msg-copied="{{ 'lucky_wheel.copied' | t | escape }}"
  data-msg-copy-fail="{{ 'lucky_wheel.copy_fail' | t | escape }}"
  {% if request.design_mode %}data-design-mode="true"{% endif %}
  style="--pgy-lw-dot-bottom: {{ block.settings.dot_bottom | default: 24 }}px"
  {{ block.shopify_attributes }}
>
  <div class="pgy-lw__shell">
    <div class="pgy-lw__lead">
      <p class="pgy-lw__lead-title">{{ 'lucky_wheel.lead_title' | t }}</p>
      <p class="pgy-lw__lead-sub">{{ 'lucky_wheel.lead_sub' | t }}</p>
    </div>
    <section class="pgy-lw__banner section-in-view" aria-labelledby="pgy-lw-title-{{ block.id }}">
    <img
      class="pgy-lw__banner-bg"
      src="{{ banner_image }}"
      alt=""
      width="3218"
      height="1178"
    >
    <div class="pgy-lw__banner-grid">
      <button type="button" class="pgy-lw__play" data-pgy-lw-open aria-label="{{ play_label | escape }}">
        <img
          src="{{ hero_image }}"
          alt=""
          width="760"
          height="760"
          loading="lazy"
        >
      </button>

      <div class="pgy-lw__copy">
        <h2 id="pgy-lw-title-{{ block.id }}" class="pgy-lw__title">{{ heading }}</h2>
        <div class="pgy-lw__how">
          <h3 class="pgy-lw__how-title">{{ how_heading }}</h3>
          <ol class="pgy-lw__steps">
            <li class="test">1.{{ step_1 }}</li>
            <li>2.{{ step_2 }}</li>
            <li>3.{{ step_3 }}</li>
            <li>4.{{ step_4 }}</li>
          </ol>
        </div>
        <button type="button" class="pgy-lw__terms-btn" data-pgy-lw-terms>
          {{ 'lucky_wheel.terms' | t }}
          <span aria-hidden="true">&gt;</span>
        </button>
      </div>
    </div>
    </section>
  </div>

  <div class="pgy-lw__overlay" data-pgy-lw-overlay hidden>
    <div class="pgy-lw__modal" role="dialog" aria-modal="true" aria-label="{{ modal_title | escape }}">
      <button type="button" class="pgy-lw__close" data-pgy-lw-close aria-label="{{ 'lucky_wheel.close' | t | escape }}">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="pgy-lw__modal-wheel">
        <div class="pgy-lw__stage">
          <img class="pgy-lw__pointer-img" src="{{ pointer_image }}" alt="" width="120" height="90">
          <div class="pgy-lw__rotor" data-pgy-lw-rotor>
            <img src="{{ disc_image }}" alt="" width="760" height="760">
          </div>
          <button type="button" class="pgy-lw__hub" data-pgy-lw-hub aria-label="{{ play_label | escape }}">
            <img src="{{ play_image }}" alt="">
          </button>
        </div>
      </div>
      <div class="pgy-lw__modal-copy">
        <div class="pgy-lw__panel" data-pgy-lw-panel="form">
          <h2 class="pgy-lw__modal-title">{{ modal_title }}</h2>
          <p class="pgy-lw__modal-sub">{{ modal_sub }}</p>
          <form class="pgy-lw__form" data-pgy-lw-form novalidate>
            <p class="pgy-lw__played" data-pgy-lw-played hidden>
              <span class="pgy-lw__played-title">{{ 'lucky_wheel.played_title' | t }}</span>
              <span data-pgy-lw-reward>{{ 'lucky_wheel.played_reward' | t }}</span>
            </p>
            <label class="pgy-lw__sr" for="pgy-lw-email-{{ block.id }}">{{ 'lucky_wheel.email' | t }}</label>
            <input
              id="pgy-lw-email-{{ block.id }}"
              class="pgy-lw__input"
              type="email"
              name="email"
              value="{{ customer_email | escape }}"
              placeholder="{{ 'lucky_wheel.email_placeholder' | t | escape }}"
              autocomplete="email"
              inputmode="email"
              required
              data-pgy-lw-email
            >
            <p class="pgy-lw__code" data-pgy-lw-code hidden></p>
            <button type="submit" class="pgy-lw__submit" data-pgy-lw-submit>{{ spin_label }}</button>
            <button type="button" class="pgy-lw__submit" data-pgy-lw-copy hidden>{{ 'lucky_wheel.copy' | t }}</button>
            <p class="pgy-lw__message" data-pgy-lw-message data-pgy-lw-copy-message hidden></p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="pgy-lw__overlay pgy-lw__overlay--terms" data-pgy-lw-terms-overlay hidden>
    <div class="pgy-lw__terms" role="dialog" aria-modal="true" aria-labelledby="pgy-lw-terms-title-{{ block.id }}">
      <button type="button" class="pgy-lw__close" data-pgy-lw-terms-close aria-label="{{ 'lucky_wheel.close' | t | escape }}">
        <span aria-hidden="true">&times;</span>
      </button>
      <h2 id="pgy-lw-terms-title-{{ block.id }}" class="pgy-lw__sr">{{ 'lucky_wheel.terms' | t }}</h2>
      <div class="pgy-lw__terms-body">
        <h3>{{ 'lucky_wheel.term_1_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_1_body' | t }}</p>
        <h3>{{ 'lucky_wheel.term_2_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_2_body' | t }}</p>
        <h3>{{ 'lucky_wheel.term_3_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_3_body' | t }}</p>
        <h3>{{ 'lucky_wheel.term_4_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_4_body' | t }}</p>
        <h3>{{ 'lucky_wheel.term_5_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_5_body' | t }}</p>
        <h3>{{ 'lucky_wheel.term_6_title' | t }}</h3>
        <p>{{ 'lucky_wheel.term_6_body' | t }}</p>
      </div>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "t:lucky_wheel.schema.name",
  "target": "section",
  "stylesheet": "lucky-wheel.css",
  "javascript": "lucky-wheel.js",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:lucky_wheel.schema.image",
      "info": "t:lucky_wheel.schema.image_info"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "t:lucky_wheel.schema.play_label",
      "default": "Play"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:lucky_wheel.schema.heading",
      "default": "Lucky Wheel — 100% Win Rate!"
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "t:lucky_wheel.schema.how_heading",
      "default": "How It Works:"
    },
    {
      "type": "text",
      "id": "step_1",
      "label": "t:lucky_wheel.schema.step_1",
      "default": "Click the “Play” button on the wheel."
    },
    {
      "type": "text",
      "id": "step_2",
      "label": "t:lucky_wheel.schema.step_2",
      "default": "Enter your email to unlock your spin."
    },
    {
      "type": "text",
      "id": "step_3",
      "label": "t:lucky_wheel.schema.step_3",
      "default": "Spin the wheel to reveal your prizes."
    },
    {
      "type": "textarea",
      "id": "step_4",
      "label": "t:lucky_wheel.schema.step_4",
      "default": "Discounts start November 18 and can be combined with Black Friday deals!"
    },
    {
      "type": "header",
      "content": "t:lucky_wheel.schema.popup"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "t:lucky_wheel.schema.modal_title",
      "default": "One Spin Per Person · Everyone Wins"
    },
    {
      "type": "textarea",
      "id": "modal_sub",
      "label": "t:lucky_wheel.schema.modal_sub",
      "default": "Sign up and spin to get your early-access link by email on November 18, and shop Black Friday deals 24 hours early."
    },
    {
      "type": "text",
      "id": "spin_label",
      "label": "t:lucky_wheel.schema.spin_label",
      "default": "SPIN TO WIN"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "t:lucky_wheel.schema.footnote",
      "default": "Discounts start November 18 and can be combined with Black Friday deals!"
    },
    {
      "type": "header",
      "content": "t:lucky_wheel.schema.wheel_labels"
    },
    {
      "type": "text",
      "id": "prize_1_label",
      "label": "t:lucky_wheel.schema.prize_1",
      "default": "Extra 2% OFF",
      "info": "t:lucky_wheel.schema.prize_1_info"
    },
    {
      "type": "text",
      "id": "prize_2_label",
      "label": "t:lucky_wheel.schema.prize_2",
      "default": "Extra 3% OFF"
    },
    {
      "type": "text",
      "id": "prize_3_label",
      "label": "t:lucky_wheel.schema.prize_3",
      "default": "Extra 5% OFF"
    },
    {
      "type": "range",
      "id": "dot_bottom",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:lucky_wheel.schema.dot_bottom",
      "default": 100
    }
  ]
}
{% endschema %}

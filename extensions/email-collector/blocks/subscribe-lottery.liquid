    },
    {
      "type": "image_picker",
      "id": "prize_3_image",
      "label": "奖品 3 图片"
    },
    {
      "type": "text",
      "id": "prize_4_title",
      "label": "奖品 4 名称",
      "default": "8% OFF Coupon"
    },
    {
      "type": "image_picker",
      "id": "prize_4_image",

{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'subscribe_lottery.heading_default' | t
  endif
  assign placeholder = block.settings.placeholder
  if placeholder == blank
    assign placeholder = 'subscribe_lottery.email_placeholder' | t
  endif
  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'subscribe_lottery.button' | t
  endif
  assign terms = block.settings.terms
  if terms == blank
    assign terms = 'subscribe_lottery.terms_default' | t
  endif
  assign proxy_url = '/apps/pgy-tech/lottery'
  assign bg_color = block.settings.background_color | default: '#fff9e5'
  assign accent_color = block.settings.accent_color | default: '#f97316'
  assign heading_color = block.settings.heading_color | default: '#1e3a5f'
%}

<div
  class="pgy-lottery"
  data-pgy-lottery
  data-proxy-url="{{ proxy_url }}"
  data-msg-success="{{ 'subscribe_lottery.success' | t | escape }}"
  data-msg-error-invalid="{{ 'subscribe_lottery.error_invalid' | t | escape }}"
  data-msg-error-generic="{{ 'subscribe_lottery.error_generic' | t | escape }}"
  data-msg-error-preview="{{ 'subscribe_lottery.error_preview' | t | escape }}"
  data-msg-error-already="{{ 'subscribe_lottery.error_already' | t | escape }}"
  data-msg-spinning="{{ 'subscribe_lottery.spinning' | t | escape }}"
  style="--pgy-lottery-bg: {{ bg_color }}; --pgy-lottery-accent: {{ accent_color }}; --pgy-lottery-heading: {{ heading_color }};"
  {{ block.shopify_attributes }}
>
  {% if heading != blank %}
    <h2 class="pgy-lottery__heading">{{ heading }}</h2>
  {% endif %}

  <div class="pgy-lottery__layout">
    <div class="pgy-lottery__prizes" data-pgy-lottery-grid>
      {% for i in (1..6) %}
        {% liquid
          assign title_key = 'prize_' | append: i | append: '_title'
          assign image_key = 'prize_' | append: i | append: '_image'
          assign prize_title = block.settings[title_key]
          if prize_title == blank
            assign prize_title = 'subscribe_lottery.prize_default' | t | append: ' ' | append: i
          endif
          assign prize_image = block.settings[image_key]
        %}
        <article
          class="pgy-lottery__prize"
          data-pgy-lottery-prize
          data-slot="{{ i }}"
        >
          <div class="pgy-lottery__prize-media">
            {% if prize_image != blank %}
              <img
                src="{{ prize_image | image_url: width: 400 }}"
                alt="{{ prize_title | escape }}"
                width="200"
                height="200"
                loading="lazy"
              >
            {% else %}
              <span class="pgy-lottery__prize-placeholder" aria-hidden="true"></span>
            {% endif %}
          </div>
          <p class="pgy-lottery__prize-label">{{ prize_title }}</p>
        </article>
      {% endfor %}
    </div>

    <div class="pgy-lottery__action">
      <div class="pgy-lottery__gift" aria-hidden="true">🎁</div>
      <form class="pgy-lottery__form" data-pgy-lottery-form>
        <div class="pgy-lottery__row">
          <div class="pgy-lottery__field">
            <label class="visually-hidden" for="pgy-lottery-email-{{ block.id }}">
              {{ 'subscribe_lottery.email_label' | t }}
            </label>
            <input
              id="pgy-lottery-email-{{ block.id }}"
              type="email"
              name="email"
              placeholder="{{ placeholder }}"
              autocomplete="email"
              required
            >
          </div>
          <button type="submit" class="pgy-lottery__button">
            {{ button_label }}
          </button>
        </div>
        <p class="pgy-lottery__message" data-pgy-lottery-message hidden></p>
      </form>
    </div>
  </div>

  {% if terms != blank %}
    <div class="pgy-lottery__terms">
      {{ terms }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "订阅抽奖",
  "target": "section",
  "stylesheet": "subscribe-lottery.css",
  "javascript": "subscribe-lottery.js",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",

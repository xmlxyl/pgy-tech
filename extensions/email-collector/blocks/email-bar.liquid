{% liquid
  assign proxy_url = '/apps/pgy-tech/email'
  assign placeholder = block.settings.placeholder
  if placeholder == blank
    assign placeholder = 'Enter your email to unlock 10% OFF'
  endif
  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'email_signup.button' | t
  endif
  assign highlight_color = block.settings.highlight_color | default: '#FF4614'
  assign border_color = block.settings.border_color | default: '#FFFFFF'
  assign campaign_type = block.settings.campaign_type | strip
  if campaign_type == blank
    assign campaign_type = block.settings.type | strip
  endif
  assign username = ''
  if customer
    if customer.name != blank
      assign username = customer.name
    elsif customer.first_name != blank
      assign username = customer.first_name
      if customer.last_name != blank
        assign username = username | append: ' ' | append: customer.last_name
      endif
    endif
  endif
%}

<div
  class="pgy-email-bar"
  style="--pgy-highlight: {{ highlight_color }}; --pgy-border: {{ border_color }};"
  {{ block.shopify_attributes }}
>
  <form
    class="pgy-email-bar__form"
    method="get"
    action="{{ proxy_url }}"
    data-pgy-email-form
    data-proxy-url="{{ proxy_url }}"
    data-campaign-type="{{ campaign_type | escape }}"
    data-msg-success={{ 'email_signup.success' | t | json }}
    data-msg-already={{ 'email_signup.already_subscribed' | t | json }}
    data-msg-error-invalid={{ 'email_signup.error_invalid' | t | json }}
    data-msg-error-generic={{ 'email_signup.error_generic' | t | json }}
    data-msg-error-preview={{ 'email_signup.error_preview' | t | json }}
  >
    <div class="pgy-email-bar__row">
      <div class="pgy-email-bar__field">
        <label class="pgy-email-bar__label" for="pgy-email-bar-{{ block.id }}">{{ 'email_signup.email_label' | t }}</label>
        <input
          id="pgy-email-bar-{{ block.id }}"
          class="pgy-email-bar__input"
          type="email"
          name="email"
          value=""
          placeholder="{{ placeholder | escape }}"
          autocomplete="email"
          required
        >
      </div>
      <span class="pgy-email-bar__divider" aria-hidden="true"></span>
      <input type="hidden" name="username" value="{{ username | escape }}">
      <input type="hidden" name="campaign_type" value="{{ campaign_type | escape }}">
      {% render 'email-submit-button', label: button_label, button_class: 'pgy-email-bar__button' %}
    </div>
    <p class="pgy-email-bar__message" data-pgy-email-message hidden role="status" aria-live="polite"></p>
  </form>
</div>

{% schema %}
{
  "name": "邮箱订阅条",
  "target": "section",
  "stylesheet": "email-bar.css",
  "javascript": "email-signup.js",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "输入框占位符",
      "default": "Enter your email to unlock 10% OFF"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "提交按钮无障碍标签",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "campaign_type",
      "label": "活动类型 type",
      "info": "用于标记本次收集来自哪次活动，例如 zipod。默认留空。"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "高亮色（聚焦）",
      "default": "#FF4614"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "边框颜色",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}

{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'email_signup.heading_default' | t
  endif
  assign subheading = block.settings.subheading
  if subheading == blank
    assign subheading = '<p>Sign up by Oct. 18 and receive <strong>10% OFF</strong> ZiPod at launch.</p>'
  endif
  assign proxy_url = '/apps/pgy-tech/email'
  assign placeholder = block.settings.placeholder
  if placeholder == blank
    assign placeholder = 'email_signup.email_placeholder' | t
  endif
  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'email_signup.button' | t
  endif
  assign highlight_color = block.settings.highlight_color | default: '#FF4614'
  assign border_color = block.settings.border_color | default: '#FFFFFF'
  assign background_color = block.settings.background_color | default: '#000000'
  assign campaign_type = block.settings.campaign_type | strip
  if campaign_type == blank
    assign campaign_type = block.settings.type | strip
  endif
  assign username = ''
  if customer
    if customer.name != blank
      assign username = customer.name
    elsif customer.first_name != blank
      assign username = customer.first_name
      if customer.last_name != blank
        assign username = username | append: ' ' | append: customer.last_name
      endif
    endif
  endif
%}

<div
  class="pgy-email-signup"
  style="--pgy-highlight: {{ highlight_color }}; --pgy-border: {{ border_color }}; --pgy-bg: {{ background_color }};"
  {{ block.shopify_attributes }}
>
  {% if heading != blank %}
    <h2 class="pgy-email-signup__heading">
      <span class="pgy-email-signup__heading-text">{{ heading }}</span>
    </h2>
  {% endif %}

  {% if subheading != blank %}
    <div class="pgy-email-signup__subheading">{{ subheading }}</div>
  {% endif %}

  <form
    class="pgy-email-signup__form"
    method="get"
    action="{{ proxy_url }}"
    data-pgy-email-form
    data-proxy-url="{{ proxy_url }}"
    data-campaign-type="{{ campaign_type | escape }}"
    data-msg-success="{{ 'email_signup.success' | t | escape }}"
    data-msg-already="{{ 'email_signup.already_subscribed' | t | escape }}"
    data-msg-error-invalid="{{ 'email_signup.error_invalid' | t | escape }}"
    data-msg-error-generic="{{ 'email_signup.error_generic' | t | escape }}"
    data-msg-error-preview="{{ 'email_signup.error_preview' | t | escape }}"
  >
    <div class="pgy-email-signup__row">
      <div class="pgy-email-signup__field">
        <label class="pgy-email-signup__label" for="pgy-email-{{ block.id }}">{{ 'email_signup.email_label' | t }}</label>
        <input
          id="pgy-email-{{ block.id }}"
          class="pgy-email-signup__input"
          type="email"
          name="email"
          value=""
          placeholder="{{ placeholder | escape }}"
          autocomplete="email"
          required
        >
      </div>
      <span class="pgy-email-signup__divider" aria-hidden="true"></span>
      <input type="hidden" name="username" value="{{ username | escape }}">
      <input type="hidden" name="campaign_type" value="{{ campaign_type | escape }}">
      {% render 'email-submit-button', label: button_label, button_class: 'pgy-email-signup__button' %}
    </div>
    <p class="pgy-email-signup__message" data-pgy-email-message hidden role="status" aria-live="polite"></p>
  </form>
</div>

{% schema %}
{
  "name": "邮箱订阅",
  "target": "section",
  "stylesheet": "email-signup.css",
  "javascript": "email-signup.js",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Get Exclusive ZiPod Early-Bird Access"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "副标题",
      "info": "将需要高亮的文字设为加粗（Bold），会显示为高亮色",
      "default": "<p>Sign up by Oct. 18 and receive <strong>10% OFF</strong> ZiPod at launch.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "输入框占位符",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "提交按钮无障碍标签",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "campaign_type",
      "label": "活动类型 type",
      "info": "用于标记本次收集来自哪次活动，例如 zipod-early-bird。默认留空。"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "高亮色（下划线 / 强调文字）",
      "default": "#FF4614"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "输入框边框颜色",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}

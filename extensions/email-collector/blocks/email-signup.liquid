{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'email_signup.heading_default' | t
  endif
  assign subheading = block.settings.subheading
  if subheading == blank
    assign subheading = 'email_signup.subheading_default' | t
  endif
  assign proxy_url = '/apps/pgy-tech/email'
  assign placeholder = block.settings.placeholder
  if placeholder == blank
    assign placeholder = 'email_signup.email_placeholder' | t
  endif
  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'email_signup.button' | t
  endif
  assign border_color = block.settings.border_color | default: '#f97316'
  assign button_color = block.settings.button_color | default: '#f97316'
  assign background_color = block.settings.background_color | default: '#ffffff'
  assign username = ''
  if customer
    if customer.name != blank
      assign username = customer.name
    elsif customer.first_name != blank
      assign username = customer.first_name
      if customer.last_name != blank
        assign username = username | append: ' ' | append: customer.last_name
      endif
    endif
  endif
%}

<div
  class="pgy-email-signup"
  style="--pgy-border: {{ border_color }}; --pgy-button: {{ button_color }}; --pgy-bg: {{ background_color }};"
  {{ block.shopify_attributes }}
>
  {% if heading != blank %}
    <h2 class="pgy-email-signup__heading">
      <span class="pgy-email-signup__heading-text h2">{{ heading }}</span>
    </h2>
  {% endif %}

  {% if subheading != blank %}
    <p class="pgy-email-signup__subheading">{{ subheading }}</p>
  {% endif %}

  <form
    class="pgy-email-signup__form"
    method="get"
    action="{{ proxy_url }}"
    data-pgy-email-form
    data-proxy-url="{{ proxy_url }}"
    data-msg-success="{{ 'email_signup.success' | t | escape }}"
    data-msg-error-invalid="{{ 'email_signup.error_invalid' | t | escape }}"
    data-msg-error-generic="{{ 'email_signup.error_generic' | t | escape }}"
    data-msg-error-preview="{{ 'email_signup.error_preview' | t | escape }}"
  >
    <div class="pgy-email-signup__row">
      <div class="pgy-email-signup__field">
        <label class="pgy-email-signup__label" for="pgy-email-{{ block.id }}">{{ 'email_signup.email_label' | t }}</label>
        <input
          id="pgy-email-{{ block.id }}"
          type="email"
          name="email"
          value=""
          placeholder="{{ placeholder }}"
          autocomplete="email"
          required
        >
      </div>
      <input type="hidden" name="username" value="{{ username | escape }}">
      <button type="submit" class="pgy-email-signup__button">
        {{ button_label }}
      </button>
    </div>
    <p class="pgy-email-signup__message" data-pgy-email-message hidden></p>
  </form>
</div>

{% schema %}
{
  "name": "邮箱订阅",
  "target": "section",
  "stylesheet": "email-signup.css",
  "javascript": "email-signup.js",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Mid-Year Event: Be the First to Know"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Get Early Access Before Everyone Else"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "输入框占位符",
      "default": "Enter Email Address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Unlock My Access"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "边框颜色",
      "default": "#F97316"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮颜色",
      "default": "#F97316"
    }
  ]
}
{% endschema %}

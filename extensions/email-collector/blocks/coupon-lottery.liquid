{% liquid
  assign section_heading = block.settings.section_heading
  if section_heading == blank
    assign section_heading = 'Celebrate & Save Big'
  endif
  assign section_subheading = block.settings.section_subheading
  if section_subheading == blank
    assign section_subheading = 'Save. Share. Celebrate 11 Years Together.'
  endif
  assign intro_heading = block.settings.intro_heading
  if intro_heading == blank
    assign intro_heading = 'Open Your Anniversary Coupon'
  endif
  assign intro_subheading = block.settings.intro_subheading
  if intro_subheading == blank
    assign intro_subheading = 'Every box unlocks a coupon'
  endif
  assign intro_button = block.settings.intro_button
  if intro_button == blank
    assign intro_button = 'Open My Coupon'
  endif
  assign intro_note = block.settings.intro_note
  if intro_note == blank
    assign intro_note = 'Sign in or create an account to open your box and redeem your coupon.'
  endif
  assign offers_heading = block.settings.offers_heading
  if offers_heading == blank
    assign offers_heading = 'Save Up to 33% OFF'
  endif
  assign offers_button = block.settings.offers_button
  if offers_button == blank
    assign offers_button = 'Shop Offers'
  endif
  assign giveaway_heading = block.settings.giveaway_heading
  if giveaway_heading == blank
    assign giveaway_heading = 'Share Your Story. Enter to Win.'
  endif
  assign giveaway_button = block.settings.giveaway_button
  if giveaway_button == blank
    assign giveaway_button = 'Enter the Giveway'
  endif
  assign form_heading = block.settings.form_heading
  if form_heading == blank
    assign form_heading = 'Open Your Anniversary Coupon'
  endif
  assign form_subheading = block.settings.form_subheading
  if form_subheading == blank
    assign form_subheading = 'Subscribe to reveal one guaranteed extra coupon. Your reward will be shown after you open the box.'
  endif
  assign agree_label = block.settings.agree_label
  if agree_label == blank
    assign agree_label = 'I agree to receive PGYTECH anniversary news and offers.'
  endif
  assign reveal_button = block.settings.reveal_button
  if reveal_button == blank
    assign reveal_button = 'Reveal My Coupon'
  endif

  assign shop_offers_href = block.settings.shop_offers_anchor | strip
  if shop_offers_href != blank
    unless shop_offers_href contains '://' or shop_offers_href contains '#' or shop_offers_href contains '/'
      assign shop_offers_href = '#' | append: shop_offers_href
    endunless
  endif

  assign giveaway_href = block.settings.giveaway_anchor | strip
  if giveaway_href != blank
    unless giveaway_href contains '://' or giveaway_href contains '#' or giveaway_href contains '/'
      assign giveaway_href = '#' | append: giveaway_href
    endunless
  endif

  if block.settings.hero_image != blank
    assign hero_image_url = block.settings.hero_image | image_url: width: 1800
  else
    assign hero_image_url = 'coupon-lottery-hero.png' | asset_url
  endif
  if block.settings.offers_image != blank
    assign offers_image_url = block.settings.offers_image | image_url: width: 1200
  else
    assign offers_image_url = 'coupon-lottery-offers.png' | asset_url
  endif
  if block.settings.giveaway_image != blank
    assign giveaway_image_url = block.settings.giveaway_image | image_url: width: 1200
  else
    assign giveaway_image_url = 'coupon-lottery-giveaway.png' | asset_url
  endif
  if block.settings.modal_image != blank
    assign modal_image_url = block.settings.modal_image | image_url: width: 1400
  elsif block.settings.hero_image != blank
    assign modal_image_url = block.settings.hero_image | image_url: width: 1400
  else
    assign modal_image_url = 'coupon-lottery-hero.png' | asset_url
  endif

  assign proxy_url = '/apps/pgy-tech/coupon-lottery'
  assign customer_email = ''
  if customer and customer.email != blank
    assign customer_email = customer.email
  endif
%}

<div
  class="pgy-coupon-lottery"
  data-pgy-coupon-lottery
  data-proxy-url="{{ proxy_url }}"
  data-customer-email="{{ customer_email | escape }}"
  data-msg-invalid="Please enter a valid email address."
  data-msg-agree="Please agree to receive anniversary news and offers."
  data-msg-error="Something went wrong. Please try again."
  data-msg-preview="Please test on the live storefront. Theme editor preview does not support App Proxy."
  data-msg-copied="Copied!"
  data-msg-copy-fail="Copy failed. Please copy manually."
  {{ block.shopify_attributes }}
>
  <section id="coupon-lottery" class="pgy-coupon-lottery__stage" aria-labelledby="pgy-cl-section-title-{{ block.id }}">
    <header class="pgy-coupon-lottery__intro">
      <h2 id="pgy-cl-section-title-{{ block.id }}" class="pgy-coupon-lottery__title">
        {{ section_heading }}
      </h2>
      <p class="pgy-coupon-lottery__subtitle">{{ section_subheading }}</p>
    </header>

    <div class="pgy-coupon-lottery__grid">
      <article class="pgy-coupon-lottery__card pgy-coupon-lottery__card--hero">
        <img
          class="pgy-coupon-lottery__card-image"
          src="{{ hero_image_url }}"
          alt=""
          width="1132"
          height="663"
          loading="lazy"
        >
        <div class="pgy-coupon-lottery__hero-copy">
          <div class="pgy-coupon-lottery__hero-text">
            <h3 class="pgy-coupon-lottery__hero-title">
              {{ intro_heading }}
            </h3>
            <p class="pgy-coupon-lottery__hero-sub">{{ intro_subheading }}</p>
          </div>

          <button type="button" class="pgy-coupon-lottery__pill" data-pgy-cl-open>
            <span class="pgy-coupon-lottery__pill-label">{{ intro_button }}</span>
            <span class="pgy-coupon-lottery__pill-icon" aria-hidden="true">
              <svg viewBox="0 0 49 49" width="49" height="49" focusable="false">
                <circle cx="24.5" cy="24.5" r="24.5" fill="#243A69"></circle>
                <path d="M18 24.5h14" stroke="#fff" stroke-width="2.2" stroke-linecap="round"></path>
                <path d="M27 18.5 33.5 24.5 27 30.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
              </svg>
            </span>
          </button>

          <div class="pgy-coupon-lottery__claimed" data-pgy-cl-claimed hidden>
            <button type="button" class="pgy-coupon-lottery__pill pgy-coupon-lottery__pill--code" data-pgy-cl-stage-copy aria-label="Copy coupon code">
              <span class="pgy-coupon-lottery__pill-label" data-pgy-cl-stage-code></span>
              <span class="pgy-coupon-lottery__pill-icon" aria-hidden="true">
                <svg viewBox="0 0 49 49" width="49" height="49" focusable="false">
                  <circle cx="24.5" cy="24.5" r="24.5" fill="#243A69"></circle>
                  <rect x="18" y="20" width="12" height="14" rx="2" fill="none" stroke="#fff" stroke-width="2"></rect>
                  <path d="M21 20v-1.5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2V26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </span>
            </button>
            <p class="pgy-coupon-lottery__claimed-meta" data-pgy-cl-stage-meta></p>
            <p class="pgy-coupon-lottery__claimed-msg" data-pgy-cl-stage-copy-message hidden></p>
          </div>
        </div>
        <p class="pgy-coupon-lottery__hero-note">{{ intro_note }}</p>
      </article>

      <div class="pgy-coupon-lottery__aside">
        <article class="pgy-coupon-lottery__card pgy-coupon-lottery__card--aside">
          <img
            class="pgy-coupon-lottery__card-image"
            src="{{ offers_image_url }}"
            alt=""
            width="574"
            height="329"
            loading="lazy"
          >
          <div class="pgy-coupon-lottery__aside-copy">
            <h3 class="pgy-coupon-lottery__aside-title">{{ offers_heading }}</h3>
            <a class="pgy-coupon-lottery__pill" href="{{ shop_offers_href | default: '#' | escape }}">
              <span class="pgy-coupon-lottery__pill-label">{{ offers_button }}</span>
              <span class="pgy-coupon-lottery__pill-icon" aria-hidden="true">
                <svg viewBox="0 0 49 49" width="49" height="49" focusable="false">
                  <circle cx="24.5" cy="24.5" r="24.5" fill="#243A69"></circle>
                  <path d="M18 24.5h14" stroke="#fff" stroke-width="2.2" stroke-linecap="round"></path>
                  <path d="M27 18.5 33.5 24.5 27 30.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
                </svg>
              </span>
            </a>
          </div>
        </article>

        <article class="pgy-coupon-lottery__card pgy-coupon-lottery__card--aside">
          <img
            class="pgy-coupon-lottery__card-image"
            src="{{ giveaway_image_url }}"
            alt=""
            width="574"
            height="323"
            loading="lazy"
          >
          <div class="pgy-coupon-lottery__aside-copy">
            <h3 class="pgy-coupon-lottery__aside-title">{{ giveaway_heading }}</h3>
            <a class="pgy-coupon-lottery__pill" href="{{ giveaway_href | default: '#' | escape }}">
              <span class="pgy-coupon-lottery__pill-label">{{ giveaway_button }}</span>
              <span class="pgy-coupon-lottery__pill-icon" aria-hidden="true">
                <svg viewBox="0 0 49 49" width="49" height="49" focusable="false">
                  <circle cx="24.5" cy="24.5" r="24.5" fill="#243A69"></circle>
                  <path d="M18 24.5h14" stroke="#fff" stroke-width="2.2" stroke-linecap="round"></path>
                  <path d="M27 18.5 33.5 24.5 27 30.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
                </svg>
              </span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="pgy-coupon-lottery__overlay" data-pgy-cl-overlay hidden>
    <div
      class="pgy-coupon-lottery__modal pgy-coupon-lottery__modal--form"
      data-pgy-cl-step="form"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pgy-cl-form-title-{{ block.id }}"
      hidden
    >
      <div class="pgy-coupon-lottery__modal-media">
        <img
          class="pgy-coupon-lottery__modal-image"
          src="{{ modal_image_url }}"
          alt=""
          width="700"
          height="640"
        >
      </div>
      <div class="pgy-coupon-lottery__modal-body">
        <button type="button" class="pgy-coupon-lottery__close" data-pgy-cl-close aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <h2 id="pgy-cl-form-title-{{ block.id }}" class="pgy-coupon-lottery__form-title">
          {{ form_heading }}
        </h2>
        <p class="pgy-coupon-lottery__form-sub">{{ form_subheading }}</p>

        <form class="pgy-coupon-lottery__form" data-pgy-cl-form novalidate>
          <label class="pgy-coupon-lottery__label" for="pgy-cl-email-{{ block.id }}">Email address</label>
          <input
            id="pgy-cl-email-{{ block.id }}"
            class="pgy-coupon-lottery__input"
            type="email"
            name="email"
            value="{{ customer_email | escape }}"
            placeholder="you@example.com"
            autocomplete="email"
            required
            data-pgy-cl-email
          >
          <label class="pgy-coupon-lottery__agree" for="pgy-cl-agree-{{ block.id }}">
            <input
              id="pgy-cl-agree-{{ block.id }}"
              class="pgy-coupon-lottery__agree-input"
              type="checkbox"
              name="agreed"
              checked
              data-pgy-cl-agree
            >
            <span class="pgy-coupon-lottery__agree-box" aria-hidden="true"></span>
            <span class="pgy-coupon-lottery__agree-text">{{ agree_label }}</span>
          </label>
          <button type="submit" class="pgy-coupon-lottery__cta pgy-coupon-lottery__cta--full" data-pgy-cl-submit>
            {{ reveal_button }}
          </button>
          <p class="pgy-coupon-lottery__message" data-pgy-cl-message hidden></p>
        </form>
      </div>
    </div>

    <div
      class="pgy-coupon-lottery__modal pgy-coupon-lottery__modal--result"
      data-pgy-cl-step="result"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pgy-cl-result-title-{{ block.id }}"
      hidden
    >
      <div class="pgy-coupon-lottery__modal-media">
        <img
          class="pgy-coupon-lottery__modal-image"
          src="{{ modal_image_url }}"
          alt=""
          width="700"
          height="640"
        >
      </div>
      <div class="pgy-coupon-lottery__modal-body">
        <button type="button" class="pgy-coupon-lottery__close" data-pgy-cl-close aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <h2 id="pgy-cl-result-title-{{ block.id }}" class="pgy-coupon-lottery__form-title" data-pgy-cl-result-title>
          Your coupon is ready
        </h2>
        <p class="pgy-coupon-lottery__form-sub" data-pgy-cl-result-sub></p>
        <div class="pgy-coupon-lottery__result-card">
          <div class="pgy-coupon-lottery__result-amount" data-pgy-cl-result-amount></div>
          <div class="pgy-coupon-lottery__result-meta" data-pgy-cl-result-meta></div>
          <div class="pgy-coupon-lottery__result-code" data-pgy-cl-result-code></div>
        </div>
        <button type="button" class="pgy-coupon-lottery__cta pgy-coupon-lottery__cta--full" data-pgy-cl-copy>
          Copy code
        </button>
        <p class="pgy-coupon-lottery__message" data-pgy-cl-copy-message hidden></p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coupon Lottery",
  "target": "section",
  "stylesheet": "coupon-lottery.css",
  "javascript": "coupon-lottery.js",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Title",
      "default": "Celebrate & Save Big"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Subtitle",
      "default": "Save. Share. Celebrate 11 Years Together."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Left card image",
      "info": "Anniversary gift box. Leave empty to use the default demo image."
    },
    {
      "type": "image_picker",
      "id": "offers_image",
      "label": "Shop Offers image"
    },
    {
      "type": "image_picker",
      "id": "giveaway_image",
      "label": "Giveaway image"
    },
    {
      "type": "image_picker",
      "id": "modal_image",
      "label": "Popup left image",
      "info": "Shown on the left of the coupon popup on desktop. Hidden on mobile. Leave empty to reuse the left card image."
    },
    {
      "type": "header",
      "content": "Left card"
    },
    {
      "type": "textarea",
      "id": "intro_heading",
      "label": "Heading",
      "default": "Open Your\nAnniversary Coupon"
    },
    {
      "type": "text",
      "id": "intro_subheading",
      "label": "Subheading",
      "default": "Every box unlocks a coupon"
    },
    {
      "type": "text",
      "id": "intro_button",
      "label": "Open button",
      "default": "Open My Coupon"
    },
    {
      "type": "textarea",
      "id": "intro_note",
      "label": "Fine print",
      "default": "Sign in or create an account to open your box and redeem your coupon."
    },
    {
      "type": "header",
      "content": "Shop Offers"
    },
    {
      "type": "textarea",
      "id": "offers_heading",
      "label": "Heading",
      "default": "Save Up to 33% OFF"
    },
    {
      "type": "text",
      "id": "offers_button",
      "label": "Button label",
      "default": "Shop Offers"
    },
    {
      "type": "text",
      "id": "shop_offers_anchor",
      "label": "Jump target ID",
      "info": "Fill an element id such as shop-offers. You can also paste #id, /path, or a full URL.",
      "default": "shop-offers"
    },
    {
      "type": "header",
      "content": "Giveaway"
    },
    {
      "type": "textarea",
      "id": "giveaway_heading",
      "label": "Heading",
      "default": "Share Your Story.\nEnter to Win."
    },
    {
      "type": "text",
      "id": "giveaway_button",
      "label": "Button label",
      "default": "Enter the Giveway"
    },
    {
      "type": "text",
      "id": "giveaway_anchor",
      "label": "Jump target ID",
      "info": "Fill an element id such as anniversary-giveaway.",
      "default": "anniversary-giveaway"
    },
    {
      "type": "header",
      "content": "Email form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Open Your Anniversary Coupon"
    },
    {
      "type": "textarea",
      "id": "form_subheading",
      "label": "Form description",
      "default": "Subscribe to reveal one guaranteed extra coupon. Your reward will be shown after you open the box."
    },
    {
      "type": "text",
      "id": "agree_label",
      "label": "Consent checkbox label",
      "default": "I agree to receive PGYTECH anniversary news and offers."
    },
    {
      "type": "text",
      "id": "reveal_button",
      "label": "Reveal button",
      "default": "Reveal My Coupon"
    }
  ]
}
{% endschema %}

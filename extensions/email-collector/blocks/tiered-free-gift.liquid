{% liquid
  assign enabled = block.settings.enabled
  assign banner_color = block.settings.banner_color | default: '#111827'
  assign accent_color = block.settings.accent_color | default: '#16a34a'
  assign gift_title_fallback = block.settings.gift_fallback_title | default: 'Free gift'
  assign tier1_threshold = block.settings.tier1_threshold | default: 149
  assign tier2_threshold = block.settings.tier2_threshold | default: 199
  assign tier3_threshold = block.settings.tier3_threshold | default: 249

  assign tier1_product = block.settings.tier1_gift_products | first
  assign tier2_product = block.settings.tier2_gift_products | first
  assign tier3_product = block.settings.tier3_gift_products | first

  assign tier1_sku = block.settings.tier1_gift_sku | strip
  assign tier2_sku = block.settings.tier2_gift_sku | strip
  assign tier3_sku = block.settings.tier3_gift_sku | strip
  assign tier1_sku_key = tier1_sku | downcase
  assign tier2_sku_key = tier2_sku | downcase
  assign tier3_sku_key = tier3_sku | downcase

  assign tier1_variant = nil
  assign tier2_variant = nil
  assign tier3_variant = nil

  if tier1_product
    if tier1_sku_key != blank
      for variant in tier1_product.variants
        assign variant_sku_key = variant.sku | strip | downcase
        if variant_sku_key == tier1_sku_key
          assign tier1_variant = variant
        endif
      endfor
    endif
    if tier1_variant == nil
      assign tier1_variant = tier1_product.selected_or_first_available_variant
    endif
  endif

  if tier2_product
    if tier2_sku_key != blank
      for variant in tier2_product.variants
        assign variant_sku_key = variant.sku | strip | downcase
        if variant_sku_key == tier2_sku_key
          assign tier2_variant = variant
        endif
      endfor
    endif
    if tier2_variant == nil
      assign tier2_variant = tier2_product.selected_or_first_available_variant
    endif
  endif

  if tier3_product
    if tier3_sku_key != blank
      for variant in tier3_product.variants
        assign variant_sku_key = variant.sku | strip | downcase
        if variant_sku_key == tier3_sku_key
          assign tier3_variant = variant
        endif
      endfor
    endif
    if tier3_variant == nil
      assign tier3_variant = tier3_product.selected_or_first_available_variant
    endif
  endif

  assign tier1_image = nil
  assign tier2_image = nil
  assign tier3_image = nil

  if tier1_variant.featured_image != blank
    assign tier1_image = tier1_variant.featured_image
  elsif tier1_variant.image != blank
    assign tier1_image = tier1_variant.image
  elsif tier1_product.featured_image != blank
    assign tier1_image = tier1_product.featured_image
  endif

  if tier2_variant.featured_image != blank
    assign tier2_image = tier2_variant.featured_image
  elsif tier2_variant.image != blank
    assign tier2_image = tier2_variant.image
  elsif tier2_product.featured_image != blank
    assign tier2_image = tier2_product.featured_image
  endif

  if tier3_variant.featured_image != blank
    assign tier3_image = tier3_variant.featured_image
  elsif tier3_variant.image != blank
    assign tier3_image = tier3_variant.image
  elsif tier3_product.featured_image != blank
    assign tier3_image = tier3_product.featured_image
  endif
%}

<script type="application/json" data-pgy-tiered-gift-config>
  {
    "enabled": {{ enabled | json }},
    "propertyName": "_pgy_tiered_gift",
    "propertyValue": "free",
    "discountLabel": {{ block.settings.gift_discount_label | default: 'BTSFREE' | json }},
    "giftFallbackTitle": {{ gift_title_fallback | json }},
    "tiers": [
      {
        "tierLevel": 1,
        "thresholdCents": {{ tier1_threshold | times: 100 }},
        "variantId": {% if tier1_variant %}{{ tier1_variant.id | json }}{% else %}null{% endif %},
        "sku": {{ tier1_sku | json }},
        "title": {% if tier1_product %}{{ tier1_product.title | json }}{% else %}null{% endif %},
        "handle": {% if tier1_product %}{{ tier1_product.handle | json }}{% else %}""{% endif %},
        "image": {% if tier1_image %}{{ tier1_image | image_url: width: 160 | json }}{% else %}null{% endif %}
      },
      {
        "tierLevel": 2,
        "thresholdCents": {{ tier2_threshold | times: 100 }},
        "variantId": {% if tier2_variant %}{{ tier2_variant.id | json }}{% else %}null{% endif %},
        "sku": {{ tier2_sku | json }},
        "title": {% if tier2_product %}{{ tier2_product.title | json }}{% else %}null{% endif %},
        "handle": {% if tier2_product %}{{ tier2_product.handle | json }}{% else %}""{% endif %},
        "image": {% if tier2_image %}{{ tier2_image | image_url: width: 160 | json }}{% else %}null{% endif %}
      },
      {
        "tierLevel": 3,
        "thresholdCents": {{ tier3_threshold | times: 100 }},
        "variantId": {% if tier3_variant %}{{ tier3_variant.id | json }}{% else %}null{% endif %},
        "sku": {{ tier3_sku | json }},
        "title": {% if tier3_product %}{{ tier3_product.title | json }}{% else %}null{% endif %},
        "handle": {% if tier3_product %}{{ tier3_product.handle | json }}{% else %}""{% endif %},
        "image": {% if tier3_image %}{{ tier3_image | image_url: width: 160 | json }}{% else %}null{% endif %}
      }
    ],
    "messages": {
      "locked": {{ block.settings.locked_message | json }},
      "unlocked": {{ block.settings.unlocked_message | json }},
      "progress": {{ block.settings.progress_message | json }},
      "empty": {{ block.settings.empty_message | json }}
    }
  }
</script>

<div
  data-pgy-tiered-gift
  style="--pgy-tiered-gift-text: {{ banner_color }}; --pgy-tiered-gift-accent: {{ accent_color }};"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Tiered free gift",
  "target": "body",
  "stylesheet": "tiered-gift-banner.css",
  "javascript": "tiered-gift-banner-loader.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable tiered free gift",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Set a threshold and gift for each tier. Enter a SKU to pin a specific variant. Gifts are added at Checkout / Buy now only."
    },
    {
      "type": "header",
      "content": "Tier 1"
    },
    {
      "type": "number",
      "id": "tier1_threshold",
      "label": "Threshold (shop currency)",
      "info": "Gift unlocks when cart subtotal reaches this amount. Do not include a currency symbol.",
      "default": 149
    },
    {
      "type": "product_list",
      "id": "tier1_gift_products",
      "label": "Gift product",
      "limit": 1
    },
    {
      "type": "text",
      "id": "tier1_gift_sku",
      "label": "Gift SKU",
      "info": "Optional. Must belong to the selected gift product. If empty, the first available variant is used."
    },
    {
      "type": "header",
      "content": "Tier 2"
    },
    {
      "type": "number",
      "id": "tier2_threshold",
      "label": "Threshold (shop currency)",
      "info": "Gift unlocks when cart subtotal reaches this amount. Do not include a currency symbol.",
      "default": 199
    },
    {
      "type": "product_list",
      "id": "tier2_gift_products",
      "label": "Gift product",
      "limit": 1
    },
    {
      "type": "text",
      "id": "tier2_gift_sku",
      "label": "Gift SKU",
      "info": "Optional. Must belong to the selected gift product. If empty, the first available variant is used."
    },
    {
      "type": "header",
      "content": "Tier 3"
    },
    {
      "type": "number",
      "id": "tier3_threshold",
      "label": "Threshold (shop currency)",
      "info": "Gift unlocks when cart subtotal reaches this amount. Do not include a currency symbol.",
      "default": 249
    },
    {
      "type": "product_list",
      "id": "tier3_gift_products",
      "label": "Gift product",
      "limit": 1
    },
    {
      "type": "text",
      "id": "tier3_gift_sku",
      "label": "Gift SKU",
      "info": "Optional. Must belong to the selected gift product. If empty, the first available variant is used."
    },
    {
      "type": "text",
      "id": "gift_discount_label",
      "label": "Gift discount label",
      "default": "BTSFREE",
      "info": "Shown on the gift line instead of FREE. Items with this label are removed when leaving the cart."
    },
    {
      "type": "text",
      "id": "gift_fallback_title",
      "label": "Gift title fallback",
      "default": "Free gift"
    },
    {
      "type": "header",
      "content": "Cart banner messages"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty cart message",
      "default": "Add items to unlock a free gift."
    },
    {
      "type": "text",
      "id": "progress_message",
      "label": "Progress message",
      "default": "Spend [remaining] more to unlock [title]",
      "info": "Placeholders: [remaining], [title], [threshold]"
    },
    {
      "type": "text",
      "id": "unlocked_message",
      "label": "Unlocked message",
      "default": "Free gift unlocked: [title] (added at checkout)",
      "info": "Placeholders: [title], [threshold]"
    },
    {
      "type": "text",
      "id": "locked_message",
      "label": "Fallback message",
      "default": "Free gift will be added at checkout."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#16A34A"
    },
    {
      "type": "color",
      "id": "banner_color",
      "label": "Text color",
      "default": "#111827"
    }
  ]
}
{% endschema %}
